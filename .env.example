# Firebase Realtime Database 설정
#
# 이 파일은 플레이스홀더만 담는다. 실제 값은 절대 커밋하지 않는다.
# 로컬에서는 이 파일을 복사해 실제 값으로 채워 쓰고,
# 배포(Vercel)에서는 대시보드의 Environment Variables에 등록한다.
#
# 주의: Vercel 대시보드에 값을 넣을 때 앞뒤에 따옴표를 붙이지 말 것.
#       따옴표가 값의 일부로 저장되어 실시간 동기화가 통째로 깨진다.
#       올바름: https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
#       틀림:  "https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app"

VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
